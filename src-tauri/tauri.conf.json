{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prisme",
  "version": "0.1.0",
  "identifier": "app.prisme.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Prisme",
        "width": 1400,
        "height": 900,
        "transparent": false,
        "decorations": true,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$HOME/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$VIDEO/**",
          "$PICTURE/**",
          "**"
        ]
      }
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "Prisme"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "publisher": "Prisme",
    "shortDescription": "L'espace de travail des créateurs YouTube"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEQUQ2MzAwQjYyRUUwQ0EKUldUSzRDNjJBR090L1ptcFpmRmhJTW9jakdTWjZROWVjZUgwOUpadUQ1Y0oxNzBTak1YOG9QTmUK",
      "endpoints": [
        "https://github.com/kauffmannsacha-pixel/hors-forfait/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}