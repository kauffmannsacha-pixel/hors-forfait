{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prisme",
  "version": "0.1.0",
  "identifier": "app.prisme.studio",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": { "windows": [{ "title": "Prisme", "width": 1400, "height": 900, "transparent": true, "decorations": true }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/icon.png"], "windows": { "nsis": { "installMode": "currentUser" } } }
}
